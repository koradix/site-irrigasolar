# =====================================================
# Supabase — captura de leads
# =====================================================
# Pegue em supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# =====================================================
# Email (Resend) — proposta enviada pro time
# =====================================================
# Pegue em resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado. Em dev pode usar "onboarding@resend.dev" (só envia pra email cadastrado na conta Resend).
EMAIL_FROM=Irrigasolar Leads <leads@irrigasolar.com.br>
# Destinatário(s) do time. Separar por vírgula pra mandar pra mais de um.
EMAIL_TO_EQUIPE=

# =====================================================
# n8n — automações (régua, CRM, notificações)
# =====================================================
# URL do webhook "Recebe lead da LP" no n8n
N8N_WEBHOOK_URL=

# =====================================================
# WhatsApp — STANDBY (não usado por enquanto)
# =====================================================
# Quando ativarmos a automação no n8n, escolher provedor:
# - Z-API (pago, simples)        → ZAPI_INSTANCE, ZAPI_TOKEN, ZAPI_CLIENT_TOKEN
# - Evolution API (free + VPS)   → EVOLUTION_URL, EVOLUTION_API_KEY
# - WhatsApp Cloud API (Meta)    → outras vars

# =====================================================
# Tracking — opcional
# =====================================================
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
