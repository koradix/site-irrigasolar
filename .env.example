# =====================================================
# Supabase — captura de leads + memória de conversa
# =====================================================
# Pegue em supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional: service_role bypassa RLS. Recomendado em produção pro webhook do WhatsApp.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================
# Email (Resend) — proposta enviada pro time
# =====================================================
# Pegue em resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM=Irrigasolar Leads <leads@irrigasolar.com.br>
EMAIL_TO_EQUIPE=

# =====================================================
# Anthropic (Claude) — cérebro do agente de WhatsApp
# =====================================================
# Pegue em console.anthropic.com
ANTHROPIC_API_KEY=
# Modelos disponíveis: claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-7
# Default: Haiku (mais barato e rápido).
ANTHROPIC_MODEL=claude-haiku-4-5

# =====================================================
# WAHA (WhatsApp HTTP API) — Docker, gratuito
# =====================================================
# Sobe via `docker compose up -d waha`, lê QR Code em http://localhost:3000/dashboard
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
# Define essa chave forte. Vira o header X-Api-Key tanto pra WAHA quanto pro nosso cliente.
WAHA_API_KEY=

# URL pública do backend Next.js (usada pelo WAHA pra disparar webhook).
# Em dev: ngrok http 3001 → cole a URL https aqui (sem barra no final).
# Em prod: https://seu-dominio.com
WEBHOOK_PUBLIC_URL=http://host.docker.internal:3001

# Opcional: HMAC pra validar que o webhook veio do WAHA (header X-Webhook-Hmac)
WAHA_WEBHOOK_HMAC=

# Segredo do endpoint POST /api/proposta (gatilho do site / integrações)
PROPOSTA_TRIGGER_SECRET=

# Identidade da empresa usada no system prompt e no PDF
EMPRESA_NOME=Irrigasolar
EMPRESA_LOGO_PATH=/assets/img/logo-irrigasolar.png

# =====================================================
# n8n — automações (régua, CRM, notificações)
# =====================================================
N8N_WEBHOOK_URL=

# =====================================================
# WhatsApp Z-API — STANDBY (mantido caso voltemos a usar)
# =====================================================
# ZAPI_INSTANCE=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=

# =====================================================
# Tracking — opcional
# =====================================================
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
